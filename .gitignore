node_modules

# Secrets / local env (never commit API keys). Repo-root .gitignore also covers these.
.env
.env.*
!.env.example
lumeneios.db.backup-*
.venv/
.venv-gpu/
__pycache__/
*.pyc
.pytest_cache/
# Runtime uploads may contain student work. Files already tracked stay tracked.
storage_uploads/*

# Local browser verification artifacts
/test-results/
/playwright-report/
/.audit-venv/
/.venv-release/

# Local demo runs (synthetic SQLite, uploads, per-run credentials)
/.local-demo/

# LearnSphere local migration backups and browser artifacts
/migration_backups/
/.browser-tests/
