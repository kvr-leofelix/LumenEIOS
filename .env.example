# LumenEIOS Environment Configuration Template

APP_NAME=LumenEIOS
APP_ENV=development
DEBUG=true
API_V1_STR=/api/v1
SECRET_KEY=change-me-use-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Database: SQLite for instant zero-dependency local runs, or PostgreSQL for production
DATABASE_URL=sqlite+aiosqlite:///./lumeneios.db
# DATABASE_URL=postgresql+asyncpg://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/YOUR_DB_NAME

# CORS Allowed Origins
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Object Storage (MinIO or AWS S3)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET_NAME=lumeneios-documents
STORAGE_LOCAL_DIR=./storage_uploads

# OCR Engine
OCR_CONFIDENCE_THRESHOLD=0.85
HF_TOKEN=
DEFAULT_VISION_MODEL=microsoft/trocr-base-handwritten
QWEN_VL_MODEL_ID=Qwen/Qwen2.5-VL-3B-Instruct-AWQ

# AI / LLM Provider (deterministic template / document-based generation — separate from Gemini)
LLM_PROVIDER=deterministic
LLM_API_KEY=

# Gemini AI question generation (preview only; never auto-saves to the bank).
# Set GEMINI_API_KEY in a local .env (gitignored) or the process environment.
# Leave empty to disable AI generation; the UI will report that the server is not configured.
# Do not put the key in frontend code, Vite env (VITE_*), commits, or logs.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_REQUEST_TIMEOUT_SECONDS=60

# Optional Neo4j Knowledge Graph
NEO4J_ENABLED=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

# Redis Cache / Tasks
REDIS_URL=redis://localhost:6379/0

# Demo Mode (seed accounts active: *@lumeneios.demo / demo123)
DEMO_MODE=true
# Frontend offline shell (no API). Keep false for live Differentiated Homework + API demo personas.
VITE_DEMO_MODE=false
# Local dev: same-origin path proxied by Vite to FastAPI. Production builds need an absolute URL.
VITE_API_URL=/api/v1
# Development root login (LEOFELIX or leofelix@lumeneios.demo).
# Use the password shown on the sign-in page. Leave blank to disable.
# Set APP_ENV=production to disable this login.
DEMO_ROOT_PASSWORD=KVR
